[Unit]
Description=OpenWitty volume bridge for LEWITT CONNECT 2 (ALSA PCM volume/mute -> device speaker)
After=pipewire.service wireplumber.service
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -I %h/Projekte/openwitty/tools/volume_bridge/openwitty_volume_bridge.py --cli %h/Projekte/openwitty/build-release/openwitty-cli
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
