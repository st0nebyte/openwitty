# OpenWitty desktop-volume integration for the LEWITT CONNECT 2 (user service).
#
# Installed DISABLED. Turn it on in OpenWitty: Settings > Desktop integration > "Keep it running when
# OpenWitty is closed" (or: systemctl --user enable --now openwitty-volumed.service).
# It follows the same settings file as the GUI ($XDG_CONFIG_HOME/openwitty/openwitty.conf): idle while
# desktop sync is off; mirror mode opens the CONNECT 2 read-only and keeps the desktop volume in step with
# the speaker knob and Mute button. Updating the desktop's ALSA control is forwarded to the device by the
# kernel; OpenWitty only ever writes the level the device already has (re-read first, rounded down, never
# unmuting). The vendor fallback is a separate, confirmed setting in the same page.
# Check the audio setup first:  @CMAKE_INSTALL_FULL_BINDIR@/openwitty-volumed --check
#   (no OpenWitty vendor USB access, no intentional hardware SET; opening the ALSA mixer can make the
#    kernel issue USB control reads to the device)
# Undo:
#     systemctl --user disable --now openwitty-volumed.service
[Unit]
Description=OpenWitty CONNECT 2 desktop volume sync (hardware knob -> desktop)
Documentation=file://@CMAKE_INSTALL_FULL_DOCDIR@/VOLUME_INTEGRATION.md man:systemd.unit(5)
After=pipewire.service wireplumber.service
PartOf=graphical-session.target
# Never restart in a tight loop if something is badly wrong (start-rate limits belong to [Unit]).
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/openwitty-volumed
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=graphical-session.target
