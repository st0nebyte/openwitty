# OpenWitty desktop-volume integration for the LEWITT CONNECT 2 (user service).
#
# Installed DISABLED. It writes the device's speaker volume/mute when you move the desktop volume,
# so enable it only after reading docs/PHASE8D_VOLUME_INTEGRATION.md:
#     systemctl --user enable --now openwitty-volumed.service
# Dry run first (no writes at all):
#     @CMAKE_INSTALL_FULL_BINDIR@/openwitty-volumed
# Undo:
#     systemctl --user disable --now openwitty-volumed.service
[Unit]
Description=OpenWitty CONNECT 2 speaker volume integration (desktop volume -> device)
Documentation=file://@CMAKE_INSTALL_FULL_DOCDIR@
After=pipewire.service wireplumber.service
PartOf=graphical-session.target

[Service]
Type=simple
Environment=LEWITT_ALLOW_HARDWARE_WRITE=1
Environment=LEWITT_ALLOW_WRITE_SPEAKER_VOLUME=1
ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/openwitty-volumed --allow-hardware-writes
Restart=on-failure
RestartSec=5
# Never restart in a tight loop if something is badly wrong.
StartLimitIntervalSec=60
StartLimitBurst=3
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=graphical-session.target
